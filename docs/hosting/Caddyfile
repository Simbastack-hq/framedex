# fdx share galleries on your own server: static files only, nothing else.
# Replace the domain and the root; `fdx share` publishes into the root over
# rsync (target: ssh://deploy@your-server:/srv/fdx-galleries, prefix: g), so
# galleries are at https://framedex.art/g/<name>-<random>/.
framedex.art {
	encode zstd gzip

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Galleries, under /g/ (the `prefix: g` in share.yaml).
	handle /g/* {
		root * /srv/fdx-galleries
		header X-Robots-Tag "noindex, nofollow, noimageindex, noarchive"

		# Photos (and their sealed .bin twins) never change under a name.
		@media path_regexp ^/g/.+/(photos|thumbs)/[0-9a-f]{16}\.(jpg|bin)$
		header @media Cache-Control "public, max-age=31536000, immutable"

		# Pages revalidate, so a re-publish shows at once.
		@pages path */ */index.html
		header @pages Cache-Control "no-cache"

		# No listing of /g/, no dotfiles (rsync's in-flight temp files).
		@list path /g/
		respond @list 404
		file_server {
			hide .*
		}
	}

	# The bare root and everything outside /g/ are left for a future landing
	# page; until then, a quiet 404.
	handle {
		respond 404
	}

	# Errors get the same quiet headers and say nothing about the server.
	handle_errors {
		header X-Robots-Tag "noindex, nofollow, noimageindex, noarchive"
		header -Server
		respond "{err.status_code}" {err.status_code}
	}
}
